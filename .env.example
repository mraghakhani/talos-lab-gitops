# Gitea reachable FROM THE KUBERNETES NODES/PODS.
GITEA_HTTP_URL=http://192.168.231.1:3000
GITEA_SSH_HOST=192.168.231.1
GITEA_SSH_PORT=2222

# Change YOUR_GITEA_USER before bootstrap.
GITOPS_REPO_URL=ssh://git@192.168.231.1:2222/YOUR_GITEA_USER/talos-gitops.git
GITOPS_BRANCH=main

# Argo CD
ARGOCD_NAMESPACE=argocd
ARGOCD_DOMAIN=argocd.<your-domain>
ARGOCD_CHART_VERSION=10.8.4
ARGOCD_APP_VERSION=3.5.2

# Proxy used by commands running on the laptop.
HOST_HTTP_PROXY=http://127.0.0.1:10808

# Proxy reachable from Talos/Kubernetes VMs.
CLUSTER_HTTP_PROXY=http://192.168.231.1:10808

# Do not proxy cluster-local traffic.
CLUSTER_NO_PROXY=localhost,127.0.0.1,.svc,.cluster.local,kubernetes.default.svc,10.96.0.0/12,10.244.0.0/16,192.168.231.0/24
